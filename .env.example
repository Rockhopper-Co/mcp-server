# Copy to .env for local dev (npm run dev / npm start). MCP clients should still
# set ROCKHOPPER_TOKEN in mcp.json — published npx runs do not ship a .env file.
ROCKHOPPER_TOKEN=rh_pat_your_token_here
# Local Nest backend: HTTPS :3100 with self-signed cert
ROCKHOPPER_API_URL=https://localhost:3100
# npm run dev sets NODE_ENV=development (skips TLS verify). For npm start / Cursor:
NODE_ENV=development
# Optional explicit override: ROCKHOPPER_TLS_INSECURE=1
