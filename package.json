{
  "name": "@rockhopper-co/mcp-server",
  "version": "2.0.1",
  "description": "Rockhopper MCP server — expose file metadata, versions, reviews, and comments to AI tools",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "rockhopper-mcp": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/copy-non-ts-assets.mjs",
    "start": "node dist/cli.js",
    "dev": "tsx watch src/cli.ts",
    "lint": "eslint src/",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run src/__tests__/unit src/__tests__/api-client.test.ts src/__tests__/server.test.ts",
    "test:e2e": "vitest run src/__tests__/e2e",
    "test:e2e:cov": "vitest run --config vitest.e2e.config.ts --coverage",
    "test:cov": "vitest run --coverage",
    "test:watch": "vitest",
    "generate:postman": "tsx scripts/generate-postman-collection.ts && tsx scripts/generate-postman-environments.ts",
    "generate:postman:check": "npm run generate:postman && git diff --exit-code -- postman/",
    "prepare": "npm run build",
    "prepublishOnly": "npm run build",
    "release:patch": "npm version patch -m 'release: v%s' && git push && git push --tags",
    "release:minor": "npm version minor -m 'release: v%s' && git push && git push --tags",
    "release:major": "npm version major -m 'release: v%s' && git push && git push --tags"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.0.0",
    "keytar": "^7.9.0",
    "pino": "^10.3.1",
    "pino-roll": "^4.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@modelcontextprotocol/client": "^2.0.0",
    "@types/node": "^26.1.1",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^10.7.0",
    "globals": "^17.11.0",
    "tsx": "^4.23.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.65.0",
    "vitest": "^4.1.10",
    "zod-to-json-schema": "^3.24.6"
  },
  "overrides": {
    "@hono/node-server@1": "^1.19.17",
    "body-parser@2": "^2.3.0",
    "brace-expansion@5": "^5.0.7",
    "fast-uri@3": "^3.1.5",
    "hono@4": "^4.12.34",
    "ip-address@10": "^10.3.1",
    "postcss@8": "^8.5.18",
    "qs@6": "^6.15.2"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "rockhopper",
    "excel",
    "file-management",
    "ai-tools",
    "cursor",
    "claude"
  ],
  "author": "Rockhopper Technologies",
  "license": "MIT",
  "homepage": "https://rockhopper.co",
  "repository": {
    "type": "git",
    "url": "https://github.com/Rockhopper-Co/mcp-server.git"
  },
  "bugs": {
    "url": "https://github.com/Rockhopper-Co/mcp-server/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
